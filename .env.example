# Required
MAX_BOT_TOKEN=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# long_polling — local run; webhook — server behind HTTPS (see README, "Деплой с webhook")
MAX_TRANSPORT=long_polling
# Webhook only
MAX_WEBHOOK_URL=
MAX_WEBHOOK_SECRET=

# Database password; the database is not reachable from outside Docker. Set your own on a server.
POSTGRES_PASSWORD=dvizhmax

# Optional
# MAX user IDs of real team profiles added to the /demo event, comma-separated
DEMO_TEAM_MAX_USER_IDS=
# KUDAGO_CITIES=[{"location":"msk","name":"Москва","timezone":"Europe/Moscow"}]
# CATALOG_REFRESH_INTERVAL_SECONDS=43200
# LOG_LEVEL=INFO
