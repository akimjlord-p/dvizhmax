# PostgreSQL connection used by the bot and catalog worker.
DATABASE_URL=postgresql+psycopg://dvizhmax:password@postgres:5432/dvizhmax

# Optional. Stores prepared personal feed queues in Redis. Without it the bot
# uses an in-process buffer, which is suitable for local development.
REDIS_URL=redis://redis:6379/0

# KudaGo cities and schedule. The default interval is 12 hours.
# Leave KUDAGO_CITIES empty to use the legacy single-city settings below.
KUDAGO_CITIES=[{"location":"msk","name":"Москва","timezone":"Europe/Moscow"}]
# KUDAGO_LOCATION=msk
# KUDAGO_CITY_NAME=Москва
# KUDAGO_CITY_TIMEZONE=Europe/Moscow
CATALOG_REFRESH_INTERVAL_SECONDS=43200

# Yandex AI Studio API key for event tagging.
YANDEX_API_KEY=
# Required to build the YandexGPT model URI, for example b1g... .
YANDEX_FOLDER_ID=
# Optional. If empty, the tagger uses gpt://<YANDEX_FOLDER_ID>/yandexgpt-5-lite.
YANDEX_MODEL_URI=

# MAX bot and webhook. The public URL must use HTTPS.
MAX_BOT_TOKEN=
# webhook for deployment, long_polling for local development.
MAX_TRANSPORT=webhook
MAX_WEBHOOK_URL=https://example.com/max/webhook
MAX_WEBHOOK_HOST=0.0.0.0
MAX_WEBHOOK_PORT=8080
MAX_WEBHOOK_PATH=/max/webhook
# 5-256 characters: Latin letters, digits, hyphen or underscore.
MAX_WEBHOOK_SECRET=
